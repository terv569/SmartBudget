<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.SmartBudget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary_light</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background</item>

        <!-- Action bar -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Button styles -->
        <item name="buttonStyle">@style/Widget.App.Button</item>

        <!-- Material components -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textStyle">bold</item>
        <item name="android:height">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_xl</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Custom EditText Style -->
    <style name="Widget.App.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:background">#80FFFFFF</item>
        <item name="android:padding">@dimen/spacing_lg</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_base</item>
    </style>
</resources>